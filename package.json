{
  "name": "@transynq/sdk",
  "version": "1.0.0",
  "description": "Official Node.js / TypeScript client for the Transynq TMS API",
  "license": "MIT",
  "author": "Transynq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qadir0108/transynq-sdk-node.git"
  },
  "homepage": "https://github.com/qadir0108/transynq-sdk-node",
  "bugs": {
    "url": "https://github.com/qadir0108/transynq-sdk-node/issues"
  },
  "keywords": [
    "transynq",
    "tms",
    "transport",
    "logistics",
    "sdk"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "docs": "typedoc",
    "examples": "tsc -p examples/tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run examples",
    "example": "tsx examples/flows.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.17.6",
    "eslint": "^9.14.0",
    "msw": "^2.6.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typedoc": "^0.28.19",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}
